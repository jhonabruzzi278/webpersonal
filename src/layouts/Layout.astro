---
import Header from "../components/Header.astro";
import "../styles/global.css";
import { getLangFromUrl } from '../utils/i18n.ts';

interface Props {
  title?: string;
  description?: string;
}

const currentLang = Astro.currentLocale || "es";
const lang = getLangFromUrl(Astro.url);
const { description, title } = Astro.props;
const isHome = ['/', '/en', '/en/'].includes(Astro.url.pathname);

const keywords = lang === 'es' 
  ? "Jonathan Guerra, desarrollador web, programador, portfolio, Astro, Next.js, Node.js, React, TailwindCSS, frontend, backend, desarrollo web"
  : "Jonathan Guerra, web developer, programmer, portfolio, Astro, Next.js, Node.js, React, TailwindCSS, frontend, backend, web development";

const language = lang === 'es' ? 'Spanish' : 'English';

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Jonathan Guerra",
  jobTitle: lang === 'es' ? 'Desarrollador Web' : 'Web Developer',
  description:
    lang === 'es'
      ? 'Desarrollador web especializado en Astro, Next.js y Node.js con más de 2 años de experiencia'
      : 'Web developer specialized in Astro, Next.js and Node.js with over 2 years of experience',
  url: Astro.site?.href,
  sameAs: [
    'https://www.linkedin.com/in/jonathanguerra278',
    'https://github.com/jhonabruzzi278',
  ],
  knowsAbout: [
    'JavaScript',
    'TypeScript',
    'React',
    'Astro',
    'Next.js',
    'Node.js',
    'TailwindCSS',
    lang === 'es' ? 'Desarrollo Web Frontend' : 'Frontend Web Development',
    lang === 'es' ? 'Desarrollo Web Backend' : 'Backend Web Development',
  ],
};
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Jonathan Guerra" />
    <meta name="robots" content="index, follow" />
    <meta name="language" content={language} />
    
    
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700;800&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet" />
    
   
    <link rel="icon" type="image/svg+xml" href="/icono.svg" />
    <link rel="apple-touch-icon" href="/icono.svg" />
    <link rel="mask-icon" href="/icono.svg" color="#000000" />
    
   
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/icono.svg', Astro.url)} />
    <meta property="og:site_name" content={lang === 'es' ? 'Jonathan Guerra - Desarrollador Web' : 'Jonathan Guerra - Web Developer'} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL('/icono.svg', Astro.url)} />
    
    
    <link rel="canonical" href={Astro.url} />
    
   
    <meta name="generator" content={Astro.generator} />
    
    
    <meta name="theme-color" content="#f3ecff" />
    <meta name="msapplication-TileColor" content="#f3ecff" />
    
    
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    
    
    <title>{title}</title>
  </head>
  <body>
    {!isHome && <Header />}

    <slot />

  </body>
</html>
