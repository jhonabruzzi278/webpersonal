---
interface Props { name: 'portfolio' | 'services' | 'resources' | 'mail' | 'arrow' | 'cloud'; class?: string }
const { name, class: className = '' } = Astro.props;
---
<svg class={className} xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'portfolio' && <><rect x="3" y="5" width="18" height="15" rx="1" /><path d="M8 5V3h8v2M3 10h18M10 10v3h4v-3" /></>}
  {name === 'services' && <><rect x="3" y="4" width="18" height="14" rx="1" /><path d="m8 10 2 2-2 2m5 0h3M8 21h8m-4-3v3" /></>}
  {name === 'resources' && <><path d="M7 3h7l4 4v14H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z" /><path d="M14 3v5h5m-7 3v7m-3-3 3 3 3-3" /></>}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="1" /><path d="m3 7 9 6 9-6" /></>}
  {name === 'arrow' && <><path d="M5 19 19 5M8 5h11v11" /></>}
  {name === 'cloud' && <><path d="M7 18h11a4 4 0 0 0 .1-8 6 6 0 0 0-11.5-1.3A4.7 4.7 0 0 0 7 18Z" /></>}
</svg>
