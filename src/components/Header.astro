---
import { getLangFromUrl } from '../utils/i18n.ts';
const lang = getLangFromUrl(Astro.url);
const home = lang === 'es' ? '/' : '/en';
const path = Astro.url.pathname;
const page = path.includes('proyectos') || path.includes('/projects') ? 'projects'
  : path.includes('servicios') || path.includes('/services') ? 'services'
  : path.includes('recursos') || path.includes('/resources') ? 'resources' : 'home';
const switchTo = {
  es: { home: '/', projects: '/proyectos', services: '/servicios', resources: '/recursos' },
  en: { home: '/en', projects: '/en/projects', services: '/en/services', resources: '/en/resources' },
};
const routes = switchTo[lang];
---

<header class="site-header" id="top">
  <div class="header-inner">
    <a class="brand" href={home} aria-label={lang === 'es' ? 'Jonathan Guerra, inicio' : 'Jonathan Guerra, home'}>
      <span class="brand-mark">JG<span aria-hidden="true">✳</span></span>
      <span class="brand-copy"><small>JG / {lang === 'es' ? 'ESPACIO DIGITAL' : 'DIGITAL SPACE'}</small><strong>{lang === 'es' ? 'Webs y recursos digitales' : 'Websites and digital resources'}</strong></span>
    </a>
    <nav class="header-nav" aria-label={lang === 'es' ? 'Navegación principal' : 'Main navigation'}>
      <a href={routes.projects} aria-current={page === 'projects' ? 'page' : undefined}>{lang === 'es' ? 'Portfolio' : 'Portfolio'}</a>
      <a href={routes.services} aria-current={page === 'services' ? 'page' : undefined}>{lang === 'es' ? 'Servicios' : 'Services'}</a>
      <a href={routes.resources} aria-current={page === 'resources' ? 'page' : undefined}>{lang === 'es' ? 'Recursos' : 'Resources'}</a>
      <a class="contact-link" href="mailto:jonathanguerra278@gmail.com">{lang === 'es' ? 'Hablemos ↗' : 'Let’s talk ↗'}</a>
    </nav>
  </div>
</header>

<style>
  .site-header { background: #fff; border-bottom: 3px solid var(--ink); }
  .header-inner { max-width: 1280px; min-height: 86px; padding: 13px 30px; margin: auto; display: flex; justify-content: space-between; align-items: center; gap: 24px; }
  .brand { display: inline-flex; align-items: center; gap: 15px; text-decoration: none; white-space: nowrap; }
  .brand-mark { width: 52px; height: 52px; flex: none; position: relative; background: var(--ink); color: var(--lilac); display: grid; place-items: center; font: 800 20px var(--font-mono); letter-spacing: -.09em; transform: rotate(-5deg); }
  .brand-mark span { position: absolute; right: -10px; top: -14px; color: #ffe066; font-size: 18px; transform: rotate(5deg); }
  .brand-copy { display: grid; gap: 3px; }
  .brand-copy small { color: var(--ink-soft); font: 800 10px var(--font-mono); letter-spacing: .03em; }
  .brand-copy strong { font-size: 18px; letter-spacing: -.05em; line-height: 1.1; }
  .header-nav { display: flex; align-items: center; gap: 5px; font: 800 11px var(--font-mono); }
  .header-nav > a { text-decoration: none; text-transform: uppercase; letter-spacing: .02em; padding: 10px 11px; border: 2px solid transparent; white-space: nowrap; }
  .header-nav > a:hover, .header-nav > a:focus-visible, .header-nav > a[aria-current='page'] { background: var(--paper-2); border-color: var(--ink); }
  .header-nav > .contact-link { background: var(--lilac); border-color: var(--ink); box-shadow: 3px 3px 0 var(--ink); margin-left: 5px; }
  .header-nav > .contact-link:hover { background: var(--lilac-strong); transform: translate(-1px, -1px); box-shadow: 4px 4px 0 var(--ink); }
  @media (max-width: 720px) {
    .header-inner { padding: 13px 20px; flex-wrap: wrap; gap: 16px; }
    .header-nav { width: 100%; justify-content: space-between; gap: 4px; }
    .header-nav > a { padding: 8px 7px; }
  }
  @media (max-width: 400px) {
    .header-nav { font-size: 9px; }
    .header-nav > a { padding: 7px 4px; }
    .header-nav > .contact-link { margin-left: 0; }
  }
</style>
